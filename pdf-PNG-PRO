<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="PDF sayfalarını yüksek çözünürlüklü PNG görsellere dönüştürün. Toplu işlem, özel boyut, DPI ve sayfa seçimi." />
  <title>PDF → Görsel Pro</title>
  <style>
    :root {
      color-scheme: light;
      --bg: #f3f5fa;
      --panel: #fff;
      --text: #172033;
      --muted: #69758a;
      --line: #e3e8f1;
      --accent: #315efb;
      --accent-dark: #244bd0;
      --soft: #edf2ff;
      --success: #16794b;
      --danger: #b42318;
      --warning: #9a6700;
      --shadow: 0 18px 55px rgba(24, 39, 75, .08);
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      min-height: 100vh;
      background: radial-gradient(circle at 12% 0%, #e8edff 0, transparent 34%), var(--bg);
      color: var(--text);
      font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }
    button, input, select { font: inherit; }
    .shell { width: min(1120px, calc(100% - 32px)); margin: 0 auto; padding: 38px 0 64px; }
    .topline { display: flex; align-items: center; gap: 12px; margin-bottom: 24px; }
    .brand-icon {
      display: grid; place-items: center; width: 44px; height: 44px; border-radius: 14px;
      color: #fff; background: linear-gradient(145deg, #4778ff, #244bd0);
      box-shadow: 0 8px 20px rgba(49, 94, 251, .22); font-size: 18px; font-weight: 900;
    }
    .brand { font-size: 14px; font-weight: 850; letter-spacing: .035em; }
    .brand span { display: block; color: var(--muted); font-size: 11px; font-weight: 550; margin-top: 3px; letter-spacing: 0; }
    h1 { font-size: clamp(29px, 4.8vw, 43px); letter-spacing: -.045em; line-height: 1.08; margin: 0 0 12px; }
    .intro { max-width: 760px; color: var(--muted); font-size: 14px; line-height: 1.7; margin: 0 0 26px; }
    .panel { background: var(--panel); border: 1px solid rgba(223, 229, 239, .9); border-radius: 21px; box-shadow: var(--shadow); padding: 24px; }
    .section-title { font-size: 15px; font-weight: 850; margin: 0 0 13px; }
    .dropzone {
      border: 1.7px dashed #b8c5dc; background: #fafbfe; border-radius: 16px;
      min-height: 165px; display: flex; flex-direction: column; align-items: center;
      justify-content: center; text-align: center; padding: 22px; cursor: pointer; transition: .18s ease;
    }
    .dropzone:hover, .dropzone.dragover { border-color: var(--accent); background: #f2f5ff; }
    .upload-icon { width: 46px; height: 46px; display: grid; place-items: center; border-radius: 14px; background: var(--soft); color: var(--accent); font-size: 24px; margin-bottom: 11px; }
    .drop-title { font-size: 15px; font-weight: 800; margin-bottom: 5px; }
    .drop-sub { color: var(--muted); font-size: 12px; line-height: 1.55; }
    .file-input { display: none; }
    .queue { display: none; margin-top: 14px; }
    .queue-head { display: flex; justify-content: space-between; align-items: center; gap: 10px; margin-bottom: 8px; }
    .queue-title { font-size: 12px; font-weight: 800; color: #465166; }
    .queue-list { display: grid; gap: 8px; }
    .queue-item { display: flex; align-items: center; gap: 11px; padding: 10px 12px; border: 1px solid var(--line); border-radius: 12px; background: #fbfcfe; min-width: 0; }
    .pdf-badge { width: 36px; height: 38px; flex: 0 0 36px; display: grid; place-items: center; border-radius: 8px; color: #b42318; background: #fff0ee; font-size: 10px; font-weight: 900; }
    .file-meta { min-width: 0; flex: 1; }
    .file-name { font-size: 12px; font-weight: 750; overflow-wrap: anywhere; }
    .file-size { color: var(--muted); font-size: 11px; margin-top: 3px; }
    .remove-file { border: 0; background: transparent; color: var(--muted); font-size: 20px; cursor: pointer; padding: 3px 7px; }
    .remove-file:hover { color: var(--danger); }
    .settings-head { display: flex; justify-content: space-between; align-items: baseline; gap: 10px; margin: 24px 0 12px; }
    .settings-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 13px; }
    .setting { border: 1px solid var(--line); border-radius: 13px; padding: 13px 14px; background: #fff; min-width: 0; }
    .setting label, .setting-label { display: block; color: var(--muted); font-size: 11px; font-weight: 750; margin-bottom: 7px; }
    .setting select, .setting input { width: 100%; min-width: 0; height: 39px; border: 1px solid #d8dfeb; border-radius: 9px; padding: 0 10px; background: #fff; color: var(--text); outline: none; font-size: 12px; }
    .setting select:focus, .setting input:focus { border-color: var(--accent); box-shadow: 0 0 0 3px rgba(49,94,251,.10); }
    .hint { color: var(--muted); font-size: 10px; line-height: 1.45; margin-top: 6px; }
    .custom-dimensions { display: none; grid-template-columns: 1fr 1fr; gap: 8px; }
    .custom-dimensions.visible { display: grid; }
    .inline-check { display: flex; align-items: center; gap: 9px; padding: 13px 14px; border: 1px solid var(--line); border-radius: 12px; margin-top: 13px; background: #fbfcfe; }
    .inline-check input { width: 16px; height: 16px; accent-color: var(--accent); }
    .inline-check label { font-size: 12px; font-weight: 700; cursor: pointer; }
    .inline-check small { display: block; color: var(--muted); font-size: 10px; font-weight: 500; margin-top: 3px; }
    .actions { display: flex; align-items: center; gap: 9px; flex-wrap: wrap; margin-top: 17px; }
    button.action { border: 0; border-radius: 11px; padding: 12px 16px; font-size: 12px; font-weight: 800; cursor: pointer; transition: .18s ease; }
    button:disabled { opacity: .48; cursor: not-allowed; }
    .primary { color: #fff; background: var(--accent); box-shadow: 0 7px 17px rgba(49,94,251,.17); }
    .primary:hover:not(:disabled) { background: var(--accent-dark); transform: translateY(-1px); }
    .secondary { color: #344054; background: #eef1f6; }
    .secondary:hover:not(:disabled) { background: #e4e9f1; }
    .danger { color: #a3261b; background: #fff0ee; }
    .privacy { color: var(--muted); font-size: 10px; margin-left: auto; }
    .progress-wrap { display: none; margin-top: 20px; }
    .progress-head { display: flex; justify-content: space-between; gap: 12px; color: var(--muted); font-size: 11px; margin-bottom: 7px; }
    .progress-track { height: 8px; border-radius: 20px; background: #edf0f5; overflow: hidden; }
    .progress-bar { width: 0%; height: 100%; background: linear-gradient(90deg, #4778ff, #315efb); border-radius: inherit; transition: width .15s ease; }
    .status { min-height: 19px; margin-top: 11px; font-size: 11px; color: var(--muted); line-height: 1.5; }
    .status.error { color: var(--danger); }
    .status.success { color: var(--success); }
    .status.warning { color: var(--warning); }
    .preview-section, .results { display: none; margin-top: 24px; border-top: 1px solid var(--line); padding-top: 21px; }
    .preview-head, .results-head { display: flex; justify-content: space-between; align-items: center; gap: 12px; margin-bottom: 13px; }
    .preview-box { min-height: 190px; display: grid; place-items: center; padding: 15px; border: 1px solid var(--line); border-radius: 13px; background: repeating-conic-gradient(#f6f7fa 0% 25%, #fff 0% 50%) 50% / 18px 18px; overflow: hidden; }
    .preview-box canvas { display: block; max-width: 100%; max-height: 490px; width: auto; height: auto; object-fit: contain; box-shadow: 0 4px 18px rgba(20,30,50,.12); background: white; }
    .preview-meta { color: var(--muted); font-size: 10px; margin-top: 9px; line-height: 1.5; }
    .results-title { font-size: 15px; font-weight: 850; }
    .results-count { color: var(--muted); font-size: 11px; margin-top: 3px; }
    .result-list { display: grid; gap: 8px; }
    .result-item { display: flex; align-items: center; gap: 11px; border: 1px solid var(--line); border-radius: 11px; padding: 10px 12px; min-width: 0; }
    .result-icon { width: 36px; height: 38px; display: grid; place-items: center; border-radius: 8px; background: var(--soft); color: var(--accent); font-size: 10px; font-weight: 900; flex: 0 0 36px; }
    .result-name { min-width: 0; flex: 1; font-size: 11px; font-weight: 750; overflow-wrap: anywhere; }
    .result-dim { display: block; color: var(--muted); font-size: 10px; font-weight: 500; margin-top: 3px; }
    .download-one { padding: 9px 11px; font-size: 10px; color: var(--accent); background: var(--soft); border: 0; border-radius: 9px; cursor: pointer; white-space: nowrap; font-weight: 800; }
    .zip-download { display: flex; align-items: center; gap: 12px; min-height: 65px; padding: 12px 14px; text-align: left; border: 1px solid #cdd9ff; border-radius: 12px; background: #f7f9ff; color: #244bd0; cursor: pointer; margin: 13px 0 17px; width: 100%; }
    .zip-mark { display: grid; place-items: center; width: 39px; height: 39px; border-radius: 9px; border: 1px solid currentColor; background: #fff; font-size: 10px; font-weight: 900; }
    .zip-download strong { display: block; font-size: 12px; }
    .zip-download small { display: block; margin-top: 3px; font-size: 10px; opacity: .75; }
    .note { display: flex; gap: 10px; align-items: flex-start; margin-top: 17px; padding: 13px 14px; border-radius: 11px; background: #f7f9fc; color: var(--muted); font-size: 10px; line-height: 1.6; }
    .note strong { color: #344054; }
    footer { text-align: center; color: #8993a4; font-size: 10px; margin-top: 20px; }
    @media (max-width: 800px) { .settings-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
    @media (max-width: 560px) {
      .shell { padding-top: 25px; }
      .panel { padding: 15px; border-radius: 16px; }
      .settings-grid { grid-template-columns: 1fr; }
      .privacy { width: 100%; margin: 2px 0 0; }
      .preview-head, .results-head { align-items: flex-start; flex-direction: column; }
      .result-item { align-items: flex-start; }
      .download-one { padding: 8px 9px; }
    }
  </style>
</head>
<body>
  <main class="shell">
    <div class="topline">
      <div class="brand-icon">P</div>
      <div class="brand">PDF → GÖRSEL PRO<span>Yerel, yüksek çözünürlüklü dönüştürücü</span></div>
    </div>

    <h1>PDF sayfalarını istediğin ölçüde görsele dönüştür.</h1>
    <p class="intro">Bir veya birden fazla PDF ekle. Her sayfa, seçtiğin ölçüde tam kare (1:1) PNG olarak hazırlanır. DPI değerini belirleyebilir, yalnızca seçtiğin sayfaları dönüştürebilirsin. İşlem tarayıcında gerçekleşir; dosyaların sunucuya gönderilmez.</p>

    <section class="panel">
      <h2 class="section-title">1. PDF dosyalarını ekle</h2>
      <label class="dropzone" id="dropzone" for="pdfInput">
        <div class="upload-icon">↑</div>
        <div class="drop-title">PDF dosyalarını buraya bırak</div>
        <div class="drop-sub">veya dosya seçmek için tıkla<br>Birden fazla PDF aynı anda eklenebilir</div>
      </label>
      <input class="file-input" id="pdfInput" type="file" accept="application/pdf,.pdf" multiple />

      <div class="queue" id="queue">
        <div class="queue-head">
          <div class="queue-title" id="queueTitle">Dosya kuyruğu</div>
          <button class="action secondary" id="clearQueueBtn" type="button">Tümünü kaldır</button>
        </div>
        <div class="queue-list" id="queueList"></div>
      </div>

      <div class="settings-head">
        <h2 class="section-title" style="margin:0">2. Çıktı ayarları</h2>
      </div>
      <div class="settings-grid">
        <div class="setting">
          <label for="resolution">Kare çıktı boyutu</label>
          <select id="resolution">
            <option value="3000">3000 × 3000 px</option>
            <option value="5000">5000 × 5000 px</option>
            <option value="7000" selected>7000 × 7000 px</option>
            <option value="10000">10000 × 10000 px</option>
            <option value="custom">Özel kare boyutu</option>
          </select>
          <div class="hint">Çıktı daima tam kare (1:1) olur. İki kenar da aynı piksel ölçüsündedir.</div>
        </div>
        <div class="setting">
          <span class="setting-label">Sabit sayfa oranı</span>
          <div class="setting-value">Kare · 1:1</div>
          <div class="hint">PDF içeriği kesilmeden, oranı bozulmadan kare tuvale ortalanır. Boş kalan alan beyaz olur.</div>
        </div>
        <div class="setting">
          <label for="dpi">DPI / baskı yoğunluğu</label>
          <select id="dpi">
            <option value="72">72 DPI</option>
            <option value="96" selected>96 DPI</option>
            <option value="150">150 DPI</option>
            <option value="300">300 DPI</option>
            <option value="600">600 DPI</option>
            <option value="custom">Özel DPI</option>
          </select>
          <div class="hint">PNG dosyasına baskı yoğunluğu metaverisi yazılır.</div>
        </div>
        <div class="setting" id="customDpiWrap" style="display:none">
          <label for="customDpi">Özel DPI değeri</label>
          <input id="customDpi" type="number" min="36" max="1200" step="1" value="300" />
          <div class="hint">36–1200 arası tam sayı.</div>
        </div>
        <div class="setting" id="customSizeWrap" style="display:none">
          <label for="customSide">Özel kare kenar uzunluğu (piksel)</label>
          <input id="customSide" type="number" min="100" max="16000" step="1" value="7000" />
          <div class="hint">Tek bir değer girilir; genişlik ve yükseklik otomatik olarak aynı yapılır. 100–16000 px.</div>
        </div>
        <div class="setting">
          <label for="pageRange">Dönüştürülecek sayfalar</label>
          <input id="pageRange" type="text" placeholder="Tümü veya 1-3, 5, 8-10" autocomplete="off" />
          <div class="hint">Boş bırakırsan tüm sayfalar; aralıkları virgülle ayır.</div>
        </div>
        <div class="setting">
          <label for="previewPage">Önizleme sayfası</label>
          <input id="previewPage" type="number" min="1" step="1" value="1" />
          <div class="hint">Önizleme, listedeki ilk PDF üzerinden alınır.</div>
        </div>
      </div>

      <div class="inline-check">
        <input id="cropWhite" type="checkbox" checked />
        <label for="cropWhite">Dış beyaz kenar boşluklarını otomatik kırp
          <small>Sayfa içeriğini algılar; içerik oranını koruyarak seçilen tuvale ortalar.</small>
        </label>
      </div>

      <div class="actions">
        <button class="action secondary" id="previewBtn" type="button" disabled>Önizleme oluştur</button>
        <button class="action primary" id="convertBtn" type="button" disabled>PNG'ye dönüştür</button>
        <button class="action danger" id="cancelBtn" type="button" style="display:none">İşlemi durdur</button>
        <span class="privacy">Dosyalar cihazında işlenir.</span>
      </div>

      <div class="progress-wrap" id="progressWrap">
        <div class="progress-head"><span id="progressLabel">Hazırlanıyor…</span><span id="progressPercent">0%</span></div>
        <div class="progress-track"><div class="progress-bar" id="progressBar"></div></div>
      </div>
      <div class="status" id="status" role="status" aria-live="polite"></div>

      <div class="preview-section" id="previewSection">
        <div class="preview-head">
          <div>
            <div class="section-title" style="margin:0">Çıktı önizlemesi</div>
            <div class="preview-meta" id="previewMeta"></div>
          </div>
        </div>
        <div class="preview-box" id="previewBox"></div>
      </div>

      <div class="results" id="results">
        <div class="results-head">
          <div>
            <div class="results-title">Dönüştürme tamamlandı</div>
            <div class="results-count" id="resultsCount"></div>
          </div>
        </div>
        <button class="zip-download" id="downloadZipBtn" type="button">
          <span class="zip-mark">ZIP</span>
          <span><strong>Tüm PNG dosyalarını indir</strong><small>PNG dosyaları tek ZIP arşivinde · Kayıpsız</small></span>
        </button>
        <div class="section-title" style="font-size:12px;margin-bottom:9px">Sayfaları tek tek indir</div>
        <div class="result-list" id="resultList"></div>
      </div>

      <div class="note">
        <span>ⓘ</span>
        <div><strong>Kare çıktı ve DPI:</strong> Her PNG dosyası kesin olarak kare olur: örneğin 7000 seçildiğinde çıktı 7000 × 7000 px olur. PDF sayfasının içeriği en-boy oranı bozulmadan kare tuvale ortalanır; içeriğin dışındaki boş alan beyaz kalır. DPI ise baskı yoğunluğu metaverisidir ve tek başına görüntüye yeni ayrıntı eklemez. PDF içindeki düşük çözünürlüklü taramalar kaynaklarında olmayan ayrıntıları kazanmaz. 10000 × 10000 px gibi çıktılar çok yüksek RAM kullanabilir.</div>
      </div>
    </section>
    <footer>PDF → Görsel Pro · PNG · Toplu dönüştürme · Tarayıcı içinde yerel işlem</footer>
  </main>

  <script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
  <script>
    (() => {
      'use strict';
      const pdfInput = document.getElementById('pdfInput');
      const dropzone = document.getElementById('dropzone');
      const queue = document.getElementById('queue');
      const queueList = document.getElementById('queueList');
      const queueTitle = document.getElementById('queueTitle');
      const resolution = document.getElementById('resolution');
      const dpiSelect = document.getElementById('dpi');
      const customDpiWrap = document.getElementById('customDpiWrap');
      const customDpi = document.getElementById('customDpi');
      const customSizeWrap = document.getElementById('customSizeWrap');
      const customSide = document.getElementById('customSide');
      const pageRange = document.getElementById('pageRange');
      const previewPageInput = document.getElementById('previewPage');
      const cropWhite = document.getElementById('cropWhite');
      const previewBtn = document.getElementById('previewBtn');
      const convertBtn = document.getElementById('convertBtn');
      const cancelBtn = document.getElementById('cancelBtn');
      const progressWrap = document.getElementById('progressWrap');
      const progressBar = document.getElementById('progressBar');
      const progressLabel = document.getElementById('progressLabel');
      const progressPercent = document.getElementById('progressPercent');
      const status = document.getElementById('status');
      const previewSection = document.getElementById('previewSection');
      const previewBox = document.getElementById('previewBox');
      const previewMeta = document.getElementById('previewMeta');
      const results = document.getElementById('results');
      const resultList = document.getElementById('resultList');
      const resultsCount = document.getElementById('resultsCount');
      const downloadZipBtn = document.getElementById('downloadZipBtn');

      let files = [];
      let converted = [];
      let busy = false;
      let cancelRequested = false;
      let activeRenderTask = null;

      if (window.pdfjsLib) {
        pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';
      }

      function formatBytes(bytes) {
        if (bytes < 1024) return bytes + ' B';
        if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + ' KB';
        return (bytes / (1024 * 1024)).toFixed(2) + ' MB';
      }
      function safeBaseName(name) {
        return name.replace(/\.pdf$/i, '').replace(/[\\/:*?"<>|]/g, '_').trim() || 'pdf';
      }
      function setStatus(message, type = '') {
        status.textContent = message;
        status.className = 'status' + (type ? ' ' + type : '');
      }
      function setProgress(done, total, label) {
        const percent = total ? Math.max(0, Math.min(100, Math.round(done / total * 100))) : 0;
        progressBar.style.width = percent + '%';
        progressPercent.textContent = percent + '%';
        progressLabel.textContent = label || 'İşleniyor…';
      }
      function clearConverted() {
        converted = [];
        resultList.innerHTML = '';
        results.style.display = 'none';
        downloadZipBtn.disabled = true;
      }
      function renderQueue() {
        queueList.innerHTML = '';
        queue.style.display = files.length ? 'block' : 'none';
        queueTitle.textContent = `Dosya kuyruğu · ${files.length} PDF`;
        files.forEach((file, index) => {
          const row = document.createElement('div');
          row.className = 'queue-item';
          const badge = document.createElement('div');
          badge.className = 'pdf-badge';
          badge.textContent = 'PDF';
          const meta = document.createElement('div');
          meta.className = 'file-meta';
          const name = document.createElement('div');
          name.className = 'file-name';
          name.textContent = file.name;
          const size = document.createElement('div');
          size.className = 'file-size';
          size.textContent = formatBytes(file.size);
          meta.append(name, size);
          const remove = document.createElement('button');
          remove.className = 'remove-file';
          remove.type = 'button';
          remove.textContent = '×';
          remove.title = 'Dosyayı kuyruktan kaldır';
          remove.setAttribute('aria-label', `${file.name} dosyasını kaldır`);
          remove.dataset.removeIndex = String(index);
          row.append(badge, meta, remove);
          queueList.appendChild(row);
        });
        previewBtn.disabled = !files.length || busy;
        convertBtn.disabled = !files.length || busy;
      }
      function addFiles(fileList) {
        if (busy) return;
        const incoming = Array.from(fileList || []);
        const valid = incoming.filter(file => file.type === 'application/pdf' || file.name.toLowerCase().endsWith('.pdf'));
        const invalidCount = incoming.length - valid.length;
        if (valid.length) {
          files.push(...valid);
          clearConverted();
          previewSection.style.display = 'none';
          renderQueue();
          setStatus(`${valid.length} PDF eklendi. Toplam dosya: ${files.length}.`);
        }
        if (invalidCount) setStatus(`${invalidCount} dosya PDF olmadığı için eklenmedi.`, 'warning');
        if (!incoming.length) return;
        if (!valid.length && !invalidCount) setStatus('PDF dosyası seçilemedi.', 'error');
      }
      function getDpi() {
        const value = dpiSelect.value === 'custom' ? Number(customDpi.value) : Number(dpiSelect.value);
        if (!Number.isInteger(value) || value < 36 || value > 1200) throw new Error('DPI değeri 36 ile 1200 arasında bir tam sayı olmalı.');
        return value;
      }
      function getOptions() {
        const side = resolution.value === 'custom' ? Number(customSide.value) : Number(resolution.value);
        if (!Number.isInteger(side) || side < 100 || side > 16000) {
          throw new Error('Kare kenar uzunluğu 100–16000 piksel arasında tam sayı olmalı.');
        }
        return { side, width: side, height: side, mode: 'square', dpi: getDpi(), crop: cropWhite.checked };
      }
      function parsePageSelection(raw, totalPages) {
        const value = raw.trim();
        if (!value) return Array.from({ length: totalPages }, (_, i) => i + 1);
        const pages = new Set();
        const parts = value.split(',');
        for (const partRaw of parts) {
          const part = partRaw.trim();
          const match = part.match(/^(\d+)\s*(?:-\s*(\d+))?$/);
          if (!match) throw new Error(`Sayfa seçimi geçersiz: “${part}”. Örnek: 1-3, 5, 8-10`);
          const start = Number(match[1]);
          const end = match[2] ? Number(match[2]) : start;
          if (start < 1 || end < start) throw new Error(`Sayfa aralığı geçersiz: “${part}”.`);
          for (let n = start; n <= Math.min(end, totalPages); n++) pages.add(n);
        }
        return Array.from(pages).sort((a, b) => a - b);
      }
      function detectContentBounds(canvas) {
        const width = canvas.width;
        const height = canvas.height;
        const context = canvas.getContext('2d', { willReadFrequently: true });
        const pixels = context.getImageData(0, 0, width, height).data;
        let left = width, top = height, right = -1, bottom = -1;
        const threshold = 250;
        for (let y = 0; y < height; y++) {
          for (let x = 0; x < width; x++) {
            const i = (y * width + x) * 4;
            if (pixels[i] < threshold || pixels[i + 1] < threshold || pixels[i + 2] < threshold) {
              if (x < left) left = x;
              if (x > right) right = x;
              if (y < top) top = y;
              if (y > bottom) bottom = y;
            }
          }
        }
        if (right < left || bottom < top) return { x: 0, y: 0, width, height };
        const padding = 2;
        left = Math.max(0, left - padding);
        top = Math.max(0, top - padding);
        right = Math.min(width - 1, right + padding);
        bottom = Math.min(height - 1, bottom + padding);
        return { x: left, y: top, width: right - left + 1, height: bottom - top + 1 };
      }
      function getTargetDimensions(_bounds, options) {
        // Çıktı oranı sabittir: her sayfa tam olarak N × N piksel kare üretilir.
        return { width: options.side, height: options.side };
      }
      async function awaitRender(task, cancellable) {
        if (cancellable) activeRenderTask = task;
        try {
          await task.promise;
        } finally {
          if (activeRenderTask === task) activeRenderTask = null;
        }
      }
      async function renderPageToCanvas(page, options, previewMaxEdge = 0, cancellable = false) {
        const scanViewport = page.getViewport({ scale: 1 });
        const scanCanvas = document.createElement('canvas');
        scanCanvas.width = Math.max(1, Math.ceil(scanViewport.width));
        scanCanvas.height = Math.max(1, Math.ceil(scanViewport.height));
        const scanCtx = scanCanvas.getContext('2d', { alpha: false, willReadFrequently: true });
        scanCtx.fillStyle = '#fff';
        scanCtx.fillRect(0, 0, scanCanvas.width, scanCanvas.height);
        const scanTask = page.render({ canvasContext: scanCtx, viewport: scanViewport });
        await awaitRender(scanTask, cancellable);

        const bounds = options.crop ? detectContentBounds(scanCanvas) : { x: 0, y: 0, width: scanCanvas.width, height: scanCanvas.height };
        const target = getTargetDimensions(bounds, options);
        let outputWidth = target.width;
        let outputHeight = target.height;
        if (previewMaxEdge && Math.max(outputWidth, outputHeight) > previewMaxEdge) {
          const factor = previewMaxEdge / Math.max(outputWidth, outputHeight);
          outputWidth = Math.max(1, Math.round(outputWidth * factor));
          outputHeight = Math.max(1, Math.round(outputHeight * factor));
        }
        const scale = Math.min(outputWidth / bounds.width, outputHeight / bounds.height);
        const viewport = page.getViewport({ scale });
        const contentWidth = bounds.width * scale;
        const contentHeight = bounds.height * scale;
        const xOffset = (outputWidth - contentWidth) / 2 - bounds.x * scale;
        const yOffset = (outputHeight - contentHeight) / 2 - bounds.y * scale;

        const outputCanvas = document.createElement('canvas');
        outputCanvas.width = outputWidth;
        outputCanvas.height = outputHeight;
        const ctx = outputCanvas.getContext('2d', { alpha: false });
        if (!ctx) throw new Error('Tarayıcı çıktı tuvalini oluşturamadı. Daha düşük çözünürlük deneyin.');
        ctx.fillStyle = '#fff';
        ctx.fillRect(0, 0, outputWidth, outputHeight);
        ctx.imageSmoothingEnabled = true;
        ctx.imageSmoothingQuality = 'high';
        const renderTask = page.render({
          canvasContext: ctx,
          viewport,
          transform: [1, 0, 0, 1, xOffset, yOffset]
        });
        await awaitRender(renderTask, cancellable);
        scanCanvas.width = 1;
        scanCanvas.height = 1;
        return { canvas: outputCanvas, width: target.width, height: target.height };
      }
      function canvasToBlob(canvas) {
        return new Promise((resolve, reject) => {
          canvas.toBlob(blob => blob ? resolve(blob) : reject(new Error('PNG dosyası oluşturulamadı.')), 'image/png');
        });
      }
      function crc32(bytes) {
        let crc = 0xffffffff;
        for (let i = 0; i < bytes.length; i++) {
          crc ^= bytes[i];
          for (let j = 0; j < 8; j++) crc = (crc >>> 1) ^ (0xedb88320 & -(crc & 1));
        }
        return (crc ^ 0xffffffff) >>> 0;
      }
      async function addPngDpiMetadata(blob, dpi) {
        const bytes = new Uint8Array(await blob.arrayBuffer());
        if (bytes.length < 33 || bytes[0] !== 137 || bytes[1] !== 80 || bytes[2] !== 78 || bytes[3] !== 71) return blob;
        const chunk = new Uint8Array(21);
        const view = new DataView(chunk.buffer);
        view.setUint32(0, 9, false);
        chunk.set([112, 72, 89, 115], 4); // pHYs
        const pixelsPerMeter = Math.round(dpi / 0.0254);
        view.setUint32(8, pixelsPerMeter, false);
        view.setUint32(12, pixelsPerMeter, false);
        view.setUint8(16, 1);
        view.setUint32(17, crc32(chunk.subarray(4, 17)), false);
        const output = new Uint8Array(bytes.length + chunk.length);
        output.set(bytes.subarray(0, 33), 0); // PNG signature + IHDR
        output.set(chunk, 33);
        output.set(bytes.subarray(33), 54);
        return new Blob([output], { type: 'image/png' });
      }
      function downloadBlob(blob, filename) {
        const url = URL.createObjectURL(blob);
        const anchor = document.createElement('a');
        anchor.href = url;
        anchor.download = filename;
        document.body.appendChild(anchor);
        anchor.click();
        anchor.remove();
        setTimeout(() => URL.revokeObjectURL(url), 2500);
      }
      function updateResults() {
        resultList.innerHTML = '';
        converted.forEach(item => {
          const row = document.createElement('div');
          row.className = 'result-item';
          const icon = document.createElement('div');
          icon.className = 'result-icon';
          icon.textContent = 'PNG';
          const name = document.createElement('div');
          name.className = 'result-name';
          name.append(document.createTextNode(item.filename));
          const detail = document.createElement('span');
          detail.className = 'result-dim';
          detail.textContent = `${item.width.toLocaleString('tr-TR')} × ${item.height.toLocaleString('tr-TR')} px · ${item.dpi} DPI · ${formatBytes(item.blob.size)}`;
          name.appendChild(detail);
          const button = document.createElement('button');
          button.className = 'download-one';
          button.type = 'button';
          button.textContent = 'PNG indir';
          button.addEventListener('click', () => downloadBlob(item.blob, item.filename));
          row.append(icon, name, button);
          resultList.appendChild(row);
        });
        resultsCount.textContent = `${converted.length} PNG dosyası hazır`;
        results.style.display = converted.length ? 'block' : 'none';
        downloadZipBtn.disabled = !converted.length;
      }
      async function makePreview() {
        if (!files.length || busy) return;
        if (!window.pdfjsLib) return setStatus('PDF.js yüklenemedi. İnternet bağlantını kontrol edip sayfayı yenile.', 'error');
        let pdf = null;
        let rendered = null;
        busy = true;
        previewBtn.disabled = true;
        convertBtn.disabled = true;
        setStatus('Önizleme hazırlanıyor…');
        try {
          const options = getOptions();
          const pageNumber = Math.max(1, Number(previewPageInput.value) || 1);
          const data = new Uint8Array(await files[0].arrayBuffer());
          pdf = await pdfjsLib.getDocument({ data }).promise;
          if (pageNumber > pdf.numPages) throw new Error(`İlk PDF yalnızca ${pdf.numPages} sayfa içeriyor.`);
          const page = await pdf.getPage(pageNumber);
          rendered = await renderPageToCanvas(page, options, 1500, false);
          previewBox.innerHTML = '';
          previewBox.appendChild(rendered.canvas);
          previewMeta.textContent = `${files[0].name} · Sayfa ${pageNumber} · Kare çıktı: ${rendered.width.toLocaleString('tr-TR')} × ${rendered.height.toLocaleString('tr-TR')} px · ${options.dpi} DPI`;
          previewSection.style.display = 'block';
          page.cleanup();
          setStatus('Önizleme hazır. Çıktı tam kare (1:1) olarak hazırlanır.', 'success');
        } catch (error) {
          console.error(error);
          setStatus('Önizleme oluşturulamadı: ' + (error.message || 'Bilinmeyen hata'), 'error');
        } finally {
          if (rendered && rendered.canvas) { /* canvas is retained in the preview */ }
          if (pdf) { try { await pdf.destroy(); } catch (_) {} }
          busy = false;
          renderQueue();
        }
      }
      async function convertAll() {
        if (!files.length || busy) return;
        if (!window.pdfjsLib || !window.JSZip) return setStatus('Gerekli kütüphaneler yüklenemedi. İnternet bağlantını kontrol edip sayfayı yenile.', 'error');
        let options;
        try { options = getOptions(); } catch (error) { setStatus(error.message, 'error'); return; }
        const targetEstimate = options.side * options.side;
        if (targetEstimate > 60000000) {
          const accepted = window.confirm('Bu çıktı boyutu çok yüksek. Tek sayfa için yüzlerce MB RAM gerekebilir; birden fazla sayfada bellek kullanımı daha da artar. Devam etmek istiyor musun?');
          if (!accepted) return;
        }
        clearConverted();
        busy = true;
        cancelRequested = false;
        convertBtn.disabled = true;
        previewBtn.disabled = true;
        cancelBtn.style.display = 'inline-block';
        progressWrap.style.display = 'block';
        setProgress(0, 1, 'Dönüştürme başlatılıyor…');
        setStatus('PDF dosyaları sırayla işleniyor. Büyük çıktılar daha fazla bellek ve zaman gerektirir.');
        const errors = [];
        let completedFiles = 0;
        try {
          for (let fileIndex = 0; fileIndex < files.length; fileIndex++) {
            if (cancelRequested) break;
            const file = files[fileIndex];
            let pdf = null;
            try {
              setProgress(fileIndex, files.length, `${fileIndex + 1}/${files.length}: ${file.name} açılıyor…`);
              const data = new Uint8Array(await file.arrayBuffer());
              pdf = await pdfjsLib.getDocument({ data }).promise;
              const pages = parsePageSelection(pageRange.value, pdf.numPages);
              if (!pages.length) throw new Error(`Seçilen sayfa numaraları bu PDF'de bulunmuyor (toplam ${pdf.numPages} sayfa).`);
              for (let pageIndex = 0; pageIndex < pages.length; pageIndex++) {
                if (cancelRequested) break;
                const pageNumber = pages[pageIndex];
                const progress = (fileIndex + pageIndex / pages.length) / files.length;
                setProgress(progress, 1, `${fileIndex + 1}/${files.length} dosya · ${pageNumber}. sayfa işleniyor…`);
                const page = await pdf.getPage(pageNumber);
                let rendered = null;
                try {
                  rendered = await renderPageToCanvas(page, options, 0, true);
                  const rawBlob = await canvasToBlob(rendered.canvas);
                  const pngBlob = await addPngDpiMetadata(rawBlob, options.dpi);
                  const pageSuffix = String(pageNumber).padStart(3, '0');
                  const prefix = files.length > 1 ? `${String(fileIndex + 1).padStart(2, '0')}_` : '';
                  const filename = `${prefix}${safeBaseName(file.name)}_sayfa_${pageSuffix}.png`;
                  converted.push({ blob: pngBlob, filename, width: rendered.width, height: rendered.height, dpi: options.dpi });
                } finally {
                  if (rendered && rendered.canvas) { rendered.canvas.width = 1; rendered.canvas.height = 1; }
                  page.cleanup();
                }
                const done = (fileIndex + (pageIndex + 1) / pages.length) / files.length;
                setProgress(done, 1, `${file.name} · ${pageNumber}/${pdf.numPages} sayfa tamamlandı`);
              }
              if (!cancelRequested) completedFiles++;
            } catch (error) {
              if (cancelRequested || (error && error.name === 'RenderingCancelledException')) break;
              console.error(error);
              errors.push(`${file.name}: ${error.message || 'İşlem başarısız.'}`);
            } finally {
              if (pdf) { try { await pdf.destroy(); } catch (_) {} }
            }
          }
          updateResults();
          if (cancelRequested) {
            setStatus(`İşlem durduruldu. Tamamlanan ${converted.length} PNG dosyası indirilebilir durumda.`, 'warning');
          } else if (errors.length) {
            setStatus(`${converted.length} PNG oluşturuldu. ${errors.length} dosyada sorun oluştu: ${errors.join(' | ')}`, converted.length ? 'warning' : 'error');
          } else if (converted.length) {
            setProgress(1, 1, 'Tüm dönüştürme işlemleri tamamlandı.');
            setStatus(`${completedFiles} PDF işlendi; toplam ${converted.length} PNG dosyası hazır.`, 'success');
          } else {
            setStatus('Dönüştürülebilecek sayfa bulunamadı.', 'error');
          }
        } catch (error) {
          console.error(error);
          setStatus('Dönüştürme başarısız: ' + (error.message || 'Bilinmeyen hata'), 'error');
          updateResults();
        } finally {
          busy = false;
          activeRenderTask = null;
          cancelBtn.style.display = 'none';
          cancelBtn.disabled = false;
          renderQueue();
        }
      }
      async function downloadZip() {
        if (!converted.length || busy) return;
        if (!window.JSZip) return setStatus('ZIP kütüphanesi yüklenemedi. Sayfayı yenileyip tekrar dene.', 'error');
        downloadZipBtn.disabled = true;
        setStatus('ZIP arşivi hazırlanıyor…');
        try {
          const zip = new JSZip();
          converted.forEach(item => zip.file(item.filename, item.blob));
          const blob = await zip.generateAsync({ type: 'blob', compression: 'STORE' }, metadata => {
            setStatus(`ZIP hazırlanıyor: %${Math.round(metadata.percent)}`);
          });
          downloadBlob(blob, `PDF_Gorsel_Pro_${new Date().toISOString().slice(0, 10)}.zip`);
          setStatus('ZIP arşivi indirilmeye hazır.', 'success');
        } catch (error) {
          setStatus('ZIP oluşturulamadı: ' + (error.message || 'Bilinmeyen hata'), 'error');
        } finally {
          downloadZipBtn.disabled = false;
        }
      }

      pdfInput.addEventListener('change', event => {
        addFiles(event.target.files);
        pdfInput.value = '';
      });
      ['dragenter', 'dragover'].forEach(name => dropzone.addEventListener(name, event => {
        event.preventDefault();
        dropzone.classList.add('dragover');
      }));
      ['dragleave', 'drop'].forEach(name => dropzone.addEventListener(name, event => {
        event.preventDefault();
        dropzone.classList.remove('dragover');
      }));
      dropzone.addEventListener('drop', event => addFiles(event.dataTransfer.files));
      queueList.addEventListener('click', event => {
        const button = event.target.closest('[data-remove-index]');
        if (!button || busy) return;
        files.splice(Number(button.dataset.removeIndex), 1);
        clearConverted();
        previewSection.style.display = 'none';
        renderQueue();
        setStatus(files.length ? 'Dosya kuyruktan kaldırıldı.' : 'Dosya kuyruğu boş.');
      });
      document.getElementById('clearQueueBtn').addEventListener('click', () => {
        if (busy) return;
        files = [];
        clearConverted();
        previewSection.style.display = 'none';
        renderQueue();
        setStatus('Tüm dosyalar kuyruktan kaldırıldı.');
      });
      resolution.addEventListener('change', () => { customSizeWrap.style.display = resolution.value === 'custom' ? 'block' : 'none'; previewSection.style.display = 'none'; });
      dpiSelect.addEventListener('change', () => { customDpiWrap.style.display = dpiSelect.value === 'custom' ? 'block' : 'none'; previewSection.style.display = 'none'; });
      [resolution, customSide, customDpi, pageRange, previewPageInput, cropWhite].forEach(control => {
        control.addEventListener('change', () => { previewSection.style.display = 'none'; });
      });
      previewBtn.addEventListener('click', makePreview);
      convertBtn.addEventListener('click', convertAll);
      downloadZipBtn.addEventListener('click', downloadZip);
      cancelBtn.addEventListener('click', () => {
        cancelRequested = true;
        if (activeRenderTask) activeRenderTask.cancel();
        cancelBtn.disabled = true;
        setStatus('Durdurma isteği gönderildi. Devam eden sayfa işlemi güvenli biçimde sonlandırılıyor…', 'warning');
      });

      renderQueue();
      if (!window.pdfjsLib || !window.JSZip) {
        setStatus('PDF.js veya JSZip yüklenemedi. Uygulamanın çalışması için internet bağlantısı gerekir.', 'error');
      }
    })();
  </script>
